{
  "name": "nebuladrop",
  "productName": "NebulaDrop 星云快传",
  "version": "0.1.0",
  "description": "局域网文件快传：星空主题界面、接收后自动定位文件、兼容 LocalSend v2 协议，并支持热点/NAT 场景的反向通道传输。",
  "main": "src/main/main.js",
  "author": "Feianxc",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.feianxc.nebuladrop",
    "productName": "NebulaDrop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NebulaDrop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NebulaDrop-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "node-forge": "^1.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Feianxc/NebulaDrop.git"
  },
  "homepage": "https://github.com/Feianxc/NebulaDrop"
}
